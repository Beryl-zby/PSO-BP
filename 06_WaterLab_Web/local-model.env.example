# Copy this file to .env.local; keep your private configuration out of Git.
QWEN_PROVIDER=local
QWEN_BASE_URL=http://127.0.0.1:11434/v1
# Replace this if ollama list returns a different installed model name.
QWEN_MODEL=qwen3.5:4b-q4_K_M
QWEN_TIMEOUT_MS=600000
# Ollama supports this opt-in setting to disable thinking for shorter responses.
# Remove it when using a server that does not support reasoning_effort.
QWEN_REASONING_EFFORT=none
# Optional local-server authentication; not a cloud API key requirement.
# QWEN_API_KEY=
# Set off only if your server does not support response_format JSON mode.
# QWEN_JSON_MODE=off

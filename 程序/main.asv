%%  清空环境变量
warning off             % 关闭报警信息
close all               % 关闭开启的图窗
clear                   % 清空变量
clc                     % 清空命令行



%%  导入数据
% 行：2004–2023（按时间顺序）
% 列：1–5 输入变量，6 输出变量
% res = xlsread('PCA_数据集_苏北.xlsx');
res = xlsread('数据集_苏北.xlsx');

%% ================= 3. 样本划分（按时间，不打乱） =================
% 训练集：2005–2020（16 年）
% 验证集：2021–2023（3 年）
temp = randperm(19);

P_train = res(1:16, 1:5)';   % 2005–2020
T_train = res(1:16, 6)';
M = size(P_train, 2);

P_test  = res(17:19, 1:5)'; % 2021–2023
T_test  = res(17:19, 6)';
N = size(P_test, 2);
%%  数据归一化
%   对输入、输出都做归一化，并保存了 ps_input、ps_output 用于反归一化
[p_train, ps_input] = mapminmax(P_train, 0, 1);
p_test = mapminmax('apply', P_test, ps_input);

[t_train, ps_output] = mapminmax(T_train, 0, 1);
t_test = mapminmax('apply', T_test, ps_output);

%% ================= 3. 极简 BP 网络（不过参数化） =================
hiddennum = 2;   % ★ 关键：1 个隐藏节点（8 个参数）

net = feedforwardnet(hiddennum, 'trainbr');   % ★ 贝叶斯正则化
net.trainParam.epochs = 300;
net.trainParam.goal   = 1e-3;
net.trainParam.showWindow = 1;

%%  网络训练
net = train(net, p_train, t_train);

%%  仿真预测
t_sim1 = sim(net, p_train);
t_sim2 = sim(net, p_test );

%%  数据反归一化
T_sim1 = mapminmax('reverse', t_sim1, ps_output);
T_sim2 = mapminmax('reverse', t_sim2, ps_output);

%%  均方根误差
error1 = sqrt(sum((T_sim1 - T_train).^2, 2)' ./ M);
error2 = sqrt(sum((T_sim2 - T_test) .^2, 2)' ./ N);

%%  绘图
figure
plot(1: M, T_train, 'r-*', 1: M, T_sim1, 'b-o', 'LineWidth', 1)
legend('真实值', '预测值')
xlabel('预测样本')
ylabel('预测结果')
string = {'训练集预测结果对比'; ['RMSE=' num2str(error1)]};
title(string)
xlim([1, M])
grid

figure
plot(1: N, T_test, 'r-*', 1: N, T_sim2, 'b-o', 'LineWidth', 1)
legend('真实值', '预测值')
xlabel('预测样本')
ylabel('预测结果')
string = {'测试集预测结果对比'; ['RMSE=' num2str(error2)]};
title(string)
xlim([1, N])
grid


%% ================= 7. 误差指标 =================
% —— 训练集
MAE_train  = mean(abs(T_sim1 - T_train));
MSE_train  = mean((T_sim1 - T_train).^2);
MAPE_train = mean(abs((T_sim1 - T_train)./T_train))*100;
NSE_train  = 1 - sum((T_sim1-T_train).^2)/sum((T_train-mean(T_train)).^2);

% —— 测试集
MAE_test  = mean(abs(T_sim2 - T_test));
MSE_test  = mean((T_sim2 - T_test).^2);
MAPE_test = mean(abs((T_sim2 - T_test)./T_test))*100;
NSE_test  = 1 - sum((T_sim2-T_test).^2)/sum((T_test-mean(T_test)).^2);

disp('—— 训练集 ——')
fprintf('MAE=%.3f  MSE=%.3f  MAPE=%.2f%%  NSE=%.3f\n', ...
        MAE_train, MSE_train, MAPE_train, NSE_train);

disp('—— 测试集 ——')
fprintf('MAE=%.3f  MSE=%.3f  MAPE=%.2f%%  NSE=%.3f\n', ...
        MAE_test, MSE_test, MAPE_test, NSE_test);

